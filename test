/* V3-00. Are the two small writers ever slow? (production)
   Baseline averages: usp_updateLetterAfterSave 11.18 ms (CPU 0.28),
   PRC_STL_GenLetter_ADD_V2 9.88 ms (CPU 0.66): both wait-bound, ~11/33
   reads. If max_ms here is in seconds while max_cpu_ms stays small, users
   hit blocking: capture it (blocked process report / Query Store waits,
   V3-00b) before changing anything. If max_ms is also small, the time users
   see is outside SQL (application / file share). */
SELECT OBJECT_NAME(ps.object_id, ps.database_id)              AS proc_name,
       ps.execution_count,
       ps.total_elapsed_time / ps.execution_count / 1000.0     AS avg_ms,
       ps.max_elapsed_time / 1000.0                            AS max_ms,
       ps.total_worker_time / ps.execution_count / 1000.0      AS avg_cpu_ms,
       ps.max_worker_time / 1000.0                             AS max_cpu_ms,
       ps.total_logical_reads / ps.execution_count             AS avg_reads,
       ps.max_logical_reads,
       ps.cached_time, ps.last_execution_time
FROM sys.dm_exec_procedure_stats ps
WHERE ps.database_id = DB_ID()
  AND OBJECT_NAME(ps.object_id, ps.database_id) IN
      ('usp_updateLetterAfterSave', 'PRC_STL_GenLetter_ADD_V2',
       'PRC_Standard_Letter_KeyValues_V1', 'SP_GET_BOM_EstimateSummary_letter');

/* V3-00b. Wait categories per procedure (Query Store, SQL 2017+; skip if
   Query Store is off). Lock = blocking, Buffer IO = cold pages,
   Tran Log IO = commit (WRITELOG), Compilation = compile. */
SELECT OBJECT_NAME(q.object_id) AS proc_name, ws.wait_category_desc,
       SUM(ws.total_query_wait_time_ms) AS wait_ms,
       MAX(ws.max_query_wait_time_ms)   AS max_wait_ms
FROM sys.query_store_wait_stats ws
JOIN sys.query_store_plan  p ON p.plan_id  = ws.plan_id
JOIN sys.query_store_query q ON q.query_id = p.query_id
WHERE q.object_id IN (OBJECT_ID('dbo.usp_updateLetterAfterSave'),
                      OBJECT_ID('dbo.PRC_STL_GenLetter_ADD_V2'),
                      OBJECT_ID('dbo.PRC_Standard_Letter_KeyValues_V1'))
GROUP BY OBJECT_NAME(q.object_id), ws.wait_category_desc
ORDER BY proc_name, wait_ms DESC;

/* V3-01.0. Which version is live? (after any deploy; lesson V2-07) */
SELECT CASE WHEN OBJECT_DEFINITION(OBJECT_ID('dbo.PRC_Standard_Letter_KeyValues_V1')) LIKE '%QPID_OPT V3-01%'
