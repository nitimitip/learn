/* V3-01.1. Legacy path trigger (= phase-1 V53.2). Rows here make EVERY
   call take the original path (shared tables, no gain from change 1).
   Modules listed in the second query make guard G2 refuse the deploy. */
SELECT 'placeholder' AS source, CAST(ID_PLACEHOLDER AS varchar(20)) AS id, MergeName AS name
FROM MT_TEM_STL_PLACEHOLDER WHERE UPPER([Desc]) LIKE '%TMP_LETTER%'
UNION ALL
SELECT 'bookmark formula', CAST(QmapID AS varchar(20)), BOOKMARKNAME
FROM MT_LETTER_BOOKMARK WHERE UPPER(ResponseText1) LIKE '%TMP_LETTER%';

SELECT o.type_desc, OBJECT_SCHEMA_NAME(o.object_id) + '.' + o.name AS module
FROM sys.sql_modules m JOIN sys.objects o ON o.object_id = m.object_id
WHERE UPPER(m.definition) LIKE '%TMP_LETTER%'
ORDER BY o.type_desc, module;

/* V3-01.2. Coverage of change 2: which fragments get the parameter.
   Mirrors the @v3_arg predicate of the procedure (first cursor: GROUP BY
   split; VAT fragments take no reference). 'literal (fallback)' rows run
   exactly as before; a letter is fully cached only when none of its
   fragments falls back. */
;WITH f AS (
    SELECT A.sLetter_ID, C.ID_PLACEHOLDER, C.MergeName, CAST(C.[Desc] AS nvarchar(max)) AS d
    FROM MT_TEM_STL_PLC_MAPPING A
    JOIN MT_TEM_STANDARDLETTER  B ON A.sLetter_ID = B.sLetter_ID
    JOIN MT_TEM_STL_PLACEHOLDER C ON A.ID_PLACEHOLDER = C.ID_PLACEHOLDER
    JOIN MT_TEM_MERGETEMPLATE   D ON B.sLetter_MergeTemID = D.MergeTem_ID
    WHERE C.MergeName NOT LIKE 'PLACEHOLDER%'
), p AS (
    SELECT f.*, g.gb,
           CASE WHEN g.gb > 0 THEN SUBSTRING(f.d, 1, g.gb - 1) ELSE f.d END AS pre,
           CASE WHEN g.gb = 0 AND f.d IN (SELECT [desc] FROM MT_TEM_STL_PLACEHOLDER
                 WHERE MergeName IN ('VatRate0Percent','VatRate5Percent','VatRate10Percent',
                                     'VatRate15Percent','VatRate17Point5Percent','VatRate20Percent'))
                THEN 1 ELSE 0 END AS vat
    FROM f CROSS APPLY (SELECT CHARINDEX('GROUP BY', UPPER(f.d)) AS gb) g
), s AS (
    SELECT p.*, r.rev, PATINDEX('%[^ ' + CHAR(9) + CHAR(10) + CHAR(13) + ']%', r.rev) AS k
    FROM p CROSS APPLY (SELECT REVERSE(p.pre) AS rev) r
), m AS (
    SELECT s.*,
           CASE WHEN s.vat = 1 THEN 'no reference (VAT)'
                WHEN s.k > 0
                 AND CHARINDEX('--', s.pre) = 0 AND CHARINDEX('/*', s.pre) = 0
                 AND CHARINDEX('[', s.pre) = 0 AND CHARINDEX('"', s.pre) = 0
                 AND (DATALENGTH(s.pre) - DATALENGTH(REPLACE(s.pre, '''', ''))) % 4 = 0
                 AND (SUBSTRING(s.rev, s.k, 1) IN ('=', '<', '>', '+')
                      OR (UPPER(SUBSTRING(s.rev, s.k, 4)) = 'EKIL'
                          AND SUBSTRING(s.rev, s.k + 4, 1) IN (' ', CHAR(9), CHAR(10), CHAR(13), ')')))
                THEN 'PARAMETER' ELSE 'literal (fallback)' END AS v3_mode
    FROM s
)
SELECT sLetter_ID, ID_PLACEHOLDER, MergeName, v3_mode,
       RIGHT(REPLACE(REPLACE(pre, CHAR(13), ' '), CHAR(10), ' '), 60) AS fragment_end
FROM m
ORDER BY CASE v3_mode WHEN 'literal (fallback)' THEN 0 ELSE 1 END, sLetter_ID, ID_PLACEHOLDER;
