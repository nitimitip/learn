/******************************************************************************
  UAT post-deploy check, 2026-10-22 (READ ONLY - nothing is changed)
  Question: V2-07 (PRC_ACT_uspActActQuery_v4) and the phase-2 indexes were
  applied on UAT but no improvement was noticed. Is the new code really
  running, and where does the time go now?
  Run on UAT in the QPID database, after a few Find Activity searches.
  Send back all result grids AND the Messages tab of the deploy run.
******************************************************************************/

-- C1. Which version is live? The V2-07 SP file refuses to deploy
--     (SET NOEXEC ON) if guard G1, G2 or G3 fails. It then prints
--     'REFUSED (Gn)' in the Messages tab and the ALTER is skipped
--     without an error. Expected: V2-07.
SELECT CASE WHEN OBJECT_DEFINITION(OBJECT_ID('dbo.PRC_ACT_uspActActQuery_v4')) LIKE '%V2-07%'
            THEN 'V2-07' ELSE 'ORIGINAL' END AS version,
       o.modify_date
FROM sys.objects o
WHERE o.object_id = OBJECT_ID('dbo.PRC_ACT_uspActActQuery_v4');

-- C2. Procedure stats since the plan was cached. cached_time must be AFTER
--     the deploy; older numbers are the old code.
SELECT ps.cached_time, ps.last_execution_time, ps.execution_count,
       ps.total_logical_reads / NULLIF(ps.execution_count, 0) AS avg_reads,
       ps.total_worker_time / NULLIF(ps.execution_count, 0) / 1000.0 AS avg_cpu_ms,
       ps.total_elapsed_time / NULLIF(ps.execution_count, 0) / 1000.0 AS avg_ms,
       ps.max_logical_reads, ps.max_worker_time / 1000.0 AS max_cpu_ms
FROM sys.dm_exec_procedure_stats ps
WHERE ps.database_id = DB_ID()
  AND ps.object_id = OBJECT_ID('dbo.PRC_ACT_uspActActQuery_v4');

-- C3. The search itself runs as EXEC(@SqlString), an ad hoc batch that is
--     NOT under the procedure in the DMVs. One row per cached search text.
--     new_text = 1: V2-07 text (inline LOV subqueries); 0: old text (UDFs).
--     The text holds search values (personal data): send the numeric
--     columns and the filter shape only, not the text.
SELECT CASE WHEN st.text LIKE '%L1.LOV_NAME%' THEN 1 ELSE 0 END AS new_text,
       qs.creation_time, qs.last_execution_time, qs.execution_count,
       qs.total_logical_reads / qs.execution_count AS avg_reads,
       qs.total_physical_reads / qs.execution_count AS avg_physical_reads,
       qs.total_worker_time / qs.execution_count / 1000.0 AS avg_cpu_ms,
       qs.total_elapsed_time / qs.execution_count / 1000.0 AS avg_ms,
       qs.total_rows / qs.execution_count AS avg_rows,
       qs.max_dop,
       LEFT(SUBSTRING(st.text, CHARINDEX('WHERE', st.text), 4000), 4000) AS where_part
FROM sys.dm_exec_query_stats qs
CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) st
WHERE st.text LIKE '%Cutomer Name%'
  AND st.text NOT LIKE '%dm_exec_query_stats%'
ORDER BY qs.total_logical_reads DESC;

-- C4. Were the UDFs already inlined (SQL Server 2019+, compatibility 150+)?
--     If fn_rpt_translateSYSLOV is_inlineable = 1 and compatibility >= 150,
--     the ORIGINAL procedure already ran them inline and V2-07 can only
--     give a small gain. Function stats show calls since the deploy.
SELECT name, compatibility_level FROM sys.databases WHERE name = DB_NAME();
SELECT o.name, m.is_inlineable
FROM sys.sql_modules m JOIN sys.objects o ON o.object_id = m.object_id
WHERE o.name IN ('fn_rpt_translateSYSLOV', 'CDMS_ACT_LOV_TypCatDecode', 'intRefPrefix');
SELECT OBJECT_NAME(object_id) AS fn, cached_time, execution_count,
       total_worker_time / NULLIF(execution_count, 0) AS avg_cpu_us,
       total_logical_reads / NULLIF(execution_count, 0) AS avg_reads
FROM sys.dm_exec_function_stats
WHERE database_id = DB_ID()
  AND OBJECT_NAME(object_id) IN ('fn_rpt_translateSYSLOV', 'CDMS_ACT_LOV_TypCatDecode', 'intRefPrefix');

-- C5. Which phase-2 indexes exist, are they enabled, are they used?
--     44-50 = existing ref indexes, must now show AE_deleted / BOM_deleted
--     as included column; 54 / 55 / 56 = new.
SELECT OBJECT_NAME(i.object_id) AS table_name, i.name, i.is_disabled,
       STUFF((SELECT ', ' + c.name FROM sys.index_columns ic
              JOIN sys.columns c ON c.object_id = ic.object_id AND c.column_id = ic.column_id
              WHERE ic.object_id = i.object_id AND ic.index_id = i.index_id AND ic.is_included_column = 1
              FOR XML PATH('')), 1, 2, '') AS included,
       us.user_seeks, us.user_scans, us.user_lookups, us.last_user_seek
FROM sys.indexes i
LEFT JOIN sys.dm_db_index_usage_stats us
       ON us.database_id = DB_ID() AND us.object_id = i.object_id AND us.index_id = i.index_id
WHERE i.name IN ('IX_BT_ENQUIRY_MASTER_AE_internalRef', 'IX_BT_QUOTE_MASTER_AE_internalRef',
                 'IX_BT_CTK_HEADER_AE_internalRef', 'IX_BT_STK_HEADER_AE_internalRef',
                 'IX_BT_PROJ_U_HEADER_AE_internalRef', 'IX_BT_PROJ_HEADER_AE_internalRef',
                 'IX_BT_ACT_BILLOFMATERIALS_BOM_internalRef',
                 'IX_BT_CTK_HEADER_AE_mpan2', 'IX_BT_STK_HEADER_AE_mpan2',
                 'IX_MT_SYSTEMPARAMETERS_SystemParamKey')
ORDER BY i.name;

-- C6. The SPs each index serves, since their plans were cached. Indexes
--     44-50 only help once the V2-03 SP is deployed; 54 / 55 help
--     usp_CheckIfMPANIsDuplicate alone and PRC_ACT_uspCTKQuery fully only
--     with the V2-06 SP; 56 saves ~27 reads per lookup (not visible on
--     one screen).
SELECT OBJECT_NAME(ps.object_id) AS sp, ps.cached_time, ps.execution_count,
       ps.total_logical_reads / NULLIF(ps.execution_count, 0) AS avg_reads,
       ps.total_worker_time / NULLIF(ps.execution_count, 0) / 1000.0 AS avg_cpu_ms,
       ps.total_elapsed_time / NULLIF(ps.execution_count, 0) / 1000.0 AS avg_ms
FROM sys.dm_exec_procedure_stats ps
WHERE ps.database_id = DB_ID()
  AND OBJECT_NAME(ps.object_id) IN ('usp_GetActivityBasedOnTypeAndWildCardName',
        'usp_CheckIfMPANIsDuplicate', 'PRC_ACT_uspCTKQuery', 'PRC_ACT_uspActActQuery_v4');
