/* V3-01.3. Plan cache: the built statements (= phase-1 V53.3). They start
   with "select '<MergeName>',(". Before V3-01: Adhoc, ~one plan per
   (letter, reference). After: Prepared, text with @qpid_v3_RefNo, plans
   reused (usecounts >> 1). Free-text answers keep query 2 unique per call. */
SELECT cp.objtype,
       CASE WHEN st.text LIKE '%@qpid_v3_RefNo%' THEN 'V3-01 parameter' ELSE 'literal' END AS form,
       COUNT(*)                         AS plans,
       SUM(CAST(cp.usecounts AS bigint)) AS uses,
       SUM(CAST(cp.size_in_bytes AS bigint)) / 1048576.0 AS cache_mb
FROM sys.dm_exec_cached_plans cp
CROSS APPLY sys.dm_exec_sql_text(cp.plan_handle) st
WHERE cp.objtype IN ('Adhoc', 'Prepared')
  AND (st.text LIKE 'select ''%'',(%'
       OR st.text LIKE '(@qpid_v3_RefNo varchar(50))select ''%'',(%')
GROUP BY cp.objtype, CASE WHEN st.text LIKE '%@qpid_v3_RefNo%' THEN 'V3-01 parameter' ELSE 'literal' END;

